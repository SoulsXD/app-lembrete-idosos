{
  "expo": {
    "name": "MedAlo",
    "slug": "MedAlo",
    "version": "0.9.6",
    "orientation": "portrait",
    "icon": "./assets/images/icone_pequeno_medalo.png",
    "scheme": "medalo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/icone_pequeno_medalo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.alonebot.MedAlo",
      "permissions": [
        "USE_FULL_SCREEN_INTENT",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "SYSTEM_ALERT_WINDOW",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icone_pequeno_medalo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo_splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0c3ec454-9439-4149-8b3b-e23fefb3ccf1"
      }
    },
    "owner": "alonebotz"
  }
}